<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Avalonia.UI.Reactor</RootNamespace>
    <!-- The package embeds the generators, the analyzers and their code fixes: an application has nothing to configure. -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);ReactorPackGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- The engine shares the scopes and the environment of the views (internal); the tests check their invariants
       (for example, that ViewProps.CopyFrom forgets no property). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Avalonia.UI.Reactor" />
    <InternalsVisibleTo Include="Avalonia.UI.Reactor.Tests" />
  </ItemGroup>

  <!-- Build rules shipped with the package: the interceptors of view builder blocks are allowed in every project that
       uses it. -->
  <ItemGroup>
    <None Include="buildTransitive\Avalonia.UI.Reactor.Core.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- The assemblies are asked of their projects (the real path of their output, even with a custom output folder), never
       read from bin/. -->
  <Target Name="ReactorPackGenerator">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../Avalonia.UI.Reactor.Generators/Avalonia.UI.Reactor.Generators.csproj;$(MSBuildThisFileDirectory)../Avalonia.UI.Reactor.CodeFixes/Avalonia.UI.Reactor.CodeFixes.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_ReactorGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_ReactorGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>

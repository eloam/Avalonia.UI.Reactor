<Project Sdk="Microsoft.NET.Sdk">

  <!-- The code fixes and refactorings of view builder blocks. They run in the IDE only, in their own assembly: an assembly
       that holds analyzers or generators must not reference the workspaces of Roslyn (RS1038). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- The rules of view builder blocks, shared with the generator and the analyzers (ViewBuilderSyntax). -->
  <ItemGroup>
    <ProjectReference Include="..\MartletUI.Generators\MartletUI.Generators.csproj" />
  </ItemGroup>

</Project>

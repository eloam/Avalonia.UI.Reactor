<Project>
  <!--
    Shipped with the MartletUI.Core package: it applies to every project that uses it (and to the projects of
    this repository, which import it from Directory.Build.targets).

    The view builder blocks are lowered with interceptors, written by the generator that the package embeds, in the
    namespace below. C# accepts interceptors only from the namespaces that a project allows.
  -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);MartletUI.Generated</InterceptorsNamespaces>
  </PropertyGroup>
</Project>

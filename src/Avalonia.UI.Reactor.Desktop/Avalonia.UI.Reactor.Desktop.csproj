<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SDL3 et l'interop Windows générée par CsWin32 manipulent des pointeurs natifs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Avalonia.UI.Reactor.Skia\Avalonia.UI.Reactor.Skia.csproj" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <!-- Déclarations Win32, COM et DirectX générées à la compilation depuis les métadonnées officielles (NativeMethods.txt). -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
  </ItemGroup>
  <!-- Règles de compilation livrées aux applications (symboles natifs non copiés). -->
  <ItemGroup>
    <None Include="buildTransitive\Avalonia.UI.Reactor.Desktop.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>

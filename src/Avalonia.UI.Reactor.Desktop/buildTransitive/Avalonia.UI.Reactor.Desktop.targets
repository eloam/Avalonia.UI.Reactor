<Project>
  <!--
    Livré avec le paquet Avalonia.UI.Reactor.Desktop : s'applique à toute application qui l'utilise (et aux projets de ce dépôt,
    qui l'importent depuis Directory.Build.targets).

    Symboles de débogage des bibliothèques natives (libSkiaSharp.pdb : environ 100 Mo) : utiles seulement pour déboguer
    Skia en C++. Ni copiés ni publiés par défaut ; ReactorCopyNativeSymbols=true pour les retrouver.
  -->
  <Target Name="ReactorSkipNativeSymbols" AfterTargets="ResolvePackageAssets" Condition="'$(ReactorCopyNativeSymbols)' != 'true'">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(AssetType)' == 'native' and '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>

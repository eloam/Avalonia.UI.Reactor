<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests du moteur Avalonia, sans fenêtre (Avalonia.Headless). Projet à part pendant la migration : Avalonia.Headless.XUnit
    impose xunit v3 (l'ancien projet est en xunit 2) et Avalonia impose SkiaSharp 3 (l'ancien moteur est en SkiaSharp 4).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avalonia.UI.Reactor\Avalonia.UI.Reactor.csproj" />
    <ProjectReference Include="..\..\samples\TodoDemo\TodoDemo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

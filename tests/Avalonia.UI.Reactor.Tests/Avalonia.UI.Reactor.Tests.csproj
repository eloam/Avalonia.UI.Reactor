<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests sans écran : une vraie fenêtre Avalonia (Avalonia.Headless, rendu par Skia) pour le moteur, et des extraits de
    code compilés en mémoire pour le générateur et l'analyseur. Avalonia.Headless.XUnit impose xunit v3.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests are not an API: their public types need no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Pour tester le générateur et l'analyseur sur des extraits de code. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avalonia.UI.Reactor\Avalonia.UI.Reactor.csproj" />
    <ProjectReference Include="..\..\samples\TodoDemo\TodoDemo.csproj" />
    <!-- Le générateur en tant que bibliothèque (GeneratorTests l'exécute sur des extraits de code) ; il est aussi
         branché comme générateur par Directory.Build.targets. Une référence de projet suit toujours la dernière
         compilation, quel que soit le dossier de sortie (un chemin vers bin/ donnait une copie périmée). -->
    <ProjectReference Include="..\..\src\Avalonia.UI.Reactor.Generators\Avalonia.UI.Reactor.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

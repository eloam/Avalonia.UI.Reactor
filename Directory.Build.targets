<Project>
  <!--
    The [State] and view builder generators, the analyzers and their code fixes, plugged into every project of the
    repository (an external application gets them through the Avalonia.UI.Reactor.Core package, see
    Avalonia.UI.Reactor.Core.csproj). PrivateAssets: they are not a dependency of the packages, they are embedded in
    Avalonia.UI.Reactor.Core.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Avalonia.UI.Reactor.Generators' and '$(MSBuildProjectName)' != 'Avalonia.UI.Reactor.CodeFixes' and '$(ReactorAutoGenerator)' != 'false'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Avalonia.UI.Reactor.Generators/Avalonia.UI.Reactor.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Avalonia.UI.Reactor.CodeFixes/Avalonia.UI.Reactor.CodeFixes.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The executables of the repository (sample app, tests) are built for the platform of the machine: only its native
    libraries (Skia, HarfBuzz) are copied, instead of those of the 14 platforms of the packages (Android, iOS, Linux…).
    For another target: dotnet publish -r linux-x64 (the value passed wins). An external application makes this choice
    itself (see "Publishing" in the README): a package cannot, since the target is read before the packages.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or '$(IsTestProject)' == 'true')">
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The same build rules as the applications that use the packages. -->
  <Import Project="$(MSBuildThisFileDirectory)src/Avalonia.UI.Reactor.Core/buildTransitive/Avalonia.UI.Reactor.Core.targets" />
  <Import Project="$(MSBuildThisFileDirectory)src/Avalonia.UI.Reactor/buildTransitive/Avalonia.UI.Reactor.targets" />
</Project>
